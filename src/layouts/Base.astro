---
import '../styles/global.css';
const { title = 'Engineering Production AI | Lokesh Jain', description = 'Practical notes on inference, distributed systems, and machine learning infrastructure.', image = '/social-card.svg', type = 'website' } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const socialImage = new URL(image, Astro.site ?? Astro.url).toString();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="theme-color" content="#f9fbfd" />
<link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<title>{title}</title>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header"><div class="shell nav"><a href="/" class="brand" aria-label="Engineering Production AI home">LJ<span>. / Engineering Production AI</span></a><button class="mobile-toggle" type="button" aria-controls="main-nav" aria-expanded="false">Menu ☰</button><nav id="main-nav" class="nav-links" aria-label="Main navigation"><a href="/articles" aria-current={pathname.startsWith('/articles') ? 'page' : undefined}>Articles</a><a href="/projects" aria-current={pathname.startsWith('/projects')?'page':undefined}>Projects</a><a href="/about" aria-current={pathname.startsWith('/about')?'page':undefined}>About</a><a href="https://github.com/lokeshjain279" target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav></div></header>
<main id="main-content"><slot /></main>
<footer class="footer"><div class="shell footer-inner"><span>© {new Date().getFullYear()} Lokesh Jain · Engineering Production AI</span><div class="footer-links"><a href="https://github.com/lokeshjain279" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/lokesh-jain-83a92b48/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="/rss.xml">RSS ↗</a><a href="mailto:lokeshjain927@gmail.com">Email ↗</a></div></div></footer>
<script>
const toggle=document.querySelector<HTMLButtonElement>('.mobile-toggle');
const nav=document.querySelector<HTMLElement>('#main-nav');
toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open)});
nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');toggle?.setAttribute('aria-expanded','false')}));
</script>
</body></html>