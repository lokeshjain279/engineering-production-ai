---
const { title = 'Engineering Production AI', description = 'Notes on inference, distributed systems, and machine learning infrastructure.' } = Astro.props;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#0c1422" />
  <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{title}</title>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');
    :root{color-scheme:dark;--bg:#0b1220;--panel:#111d30;--line:#26364b;--text:#f3f6fc;--muted:#9daec2;--accent:#9fd6be;--accent2:#b4c7f5}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 'DM Sans',sans-serif}a{color:inherit;text-decoration:none}a:hover{color:var(--accent)}.shell{max-width:1120px;margin:auto;padding:0 28px}.site-header{border-bottom:1px solid var(--line)}.nav{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font:700 19px 'Space Grotesk',sans-serif;letter-spacing:-.04em}.brand span{color:var(--accent)}.nav-links{display:flex;gap:28px;font-size:14px;color:var(--muted)}.nav-links a[aria-current=page]{color:var(--text)}.eyebrow{color:var(--accent);font:700 12px 'Space Grotesk',sans-serif;letter-spacing:.16em;text-transform:uppercase}.hero{padding:94px 0 72px;max-width:850px}.hero h1{font:700 clamp(44px,7vw,83px)/1.08 'Space Grotesk',sans-serif;letter-spacing:-.06em;margin:20px 0}.hero h1 em{font-style:normal;color:var(--accent)}.lead{font-size:19px;color:var(--muted);max-width:700px}.actions{display:flex;gap:14px;margin-top:32px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;padding:12px 20px;border-radius:8px;background:var(--accent);color:#10221c;font-weight:700;font-size:14px}.button:hover{color:#10221c;background:#b6e5d0}.button.secondary{background:transparent;color:var(--text);border:1px solid var(--line)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:0 0 26px}.section-heading h2{font:700 30px 'Space Grotesk',sans-serif;letter-spacing:-.04em;margin:0}.section-heading a{color:var(--accent);font-size:14px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.article-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:25px;display:flex;flex-direction:column;min-height:295px;transition:transform .2s,border-color .2s}.article-card:hover{transform:translateY(-3px);border-color:#628e8b}.article-card h3{font:600 22px/1.3 'Space Grotesk',sans-serif;letter-spacing:-.035em;margin:18px 0 10px}.article-card p{font-size:14px;color:var(--muted);margin:0}.card-meta{font-size:12px;color:var(--accent);letter-spacing:.07em;text-transform:uppercase}.card-bottom{margin-top:auto;padding-top:24px;color:var(--muted);font-size:12px}.section{padding:45px 0 80px}.pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:30px}.pillar{border-top:1px solid var(--line);padding-top:18px}.pillar h3{font:600 19px 'Space Grotesk',sans-serif;margin:0 0 8px}.pillar p{color:var(--muted);font-size:14px;margin:0}.footer{border-top:1px solid var(--line);padding:30px 0;color:var(--muted);font-size:13px}.footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer-links{display:flex;gap:20px}.page-head{padding:70px 0 35px}.page-head h1{font:700 clamp(40px,6vw,64px)/1.12 'Space Grotesk',sans-serif;letter-spacing:-.05em;margin:12px 0}.page-head p{max-width:720px;color:var(--muted);font-size:18px}.prose{max-width:760px;margin:0 auto 90px}.prose h2{font:600 29px 'Space Grotesk',sans-serif;letter-spacing:-.035em;margin:46px 0 15px}.prose h3{font:600 21px 'Space Grotesk',sans-serif;margin:30px 0 12px}.prose p,.prose li{color:#cbd5e2}.prose strong{color:var(--text)}.prose a{color:var(--accent);text-decoration:underline}.prose blockquote{border-left:3px solid var(--accent);margin-left:0;padding-left:20px}.prose pre{background:#101d2d;padding:20px;border-radius:12px;overflow-x:auto}.prose code{font-size:.9em}.prose img{max-width:100%}.filter-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:30px}.filter-row button{background:transparent;color:var(--muted);border:1px solid var(--line);border-radius:99px;padding:7px 14px;cursor:pointer;font:inherit;font-size:13px}.filter-row button.active{background:var(--accent);color:#10221c;border-color:var(--accent)}@media(max-width:780px){.grid,.pillars{grid-template-columns:1fr}.hero{padding:65px 0 50px}.nav-links{gap:14px}.nav{flex-wrap:wrap;padding:18px 0}.section{padding:35px 0 55px}.article-card{min-height:220px}}
  </style>
</head>
<body>
  <header class="site-header"><div class="shell nav"><a href="/" class="brand">Lokesh Jain <span>/ engineering notes</span></a><nav class="nav-links" aria-label="Main navigation"><a href="/articles" aria-current={pathname.startsWith('/articles') ? 'page' : undefined}>Articles</a><a href="/projects" aria-current={pathname==='/projects'?'page':undefined}>Projects</a><a href="/about" aria-current={pathname==='/about'?'page':undefined}>About</a></nav></div></header>
  <main><slot /></main>
  <footer class="footer"><div class="shell footer-inner"><span>© {new Date().getFullYear()} Lokesh Jain · Engineering Production AI</span><div class="footer-links"><a href="https://www.linkedin.com/in/lokesh-jain-83a92b48/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="/rss.xml">RSS ↗</a><a href="mailto:lokeshjain927@gmail.com">Email ↗</a></div></div></footer>
</body>
</html>
